{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excalibase.io/schemas/metadata-v1.json",
  "title": "Excalibase metadata document, format 1",
  "description": "Permissions: the Hasura-style rules of docs/features/permissions.md. The engine's parser is the authority: run `excalibase validate <file>` for the full check. This schema is for editor autocomplete and covers the structure, not the filter expressions. The `jwt` section applies only when the engine runs with a metadata source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "projectId"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "description": "Must equal the engine's APP_PROJECT_ID."
    },
    "jwt": {
      "type": "object",
      "additionalProperties": false,
      "description": "DEPRECATED: move these settings to the engine (APP_AUTH_ISSUER, APP_AUTH_JWKS_URL, APP_AUTH_SECRET or APP_AUTH_SECRET_FILE, APP_AUTH_AUDIENCE, APP_AUTH_ALGORITHMS, APP_AUTH_CLOCK_SKEW_SECONDS, APP_AUTH_CLAIMS_ROLE, APP_AUTH_CLAIMS_DEFAULT_ROLE, APP_AUTH_CLAIMS_USER_ID, APP_AUTH_CLAIMS_EXTRA). Token verification for a standalone engine: Auth0, Cognito, Keycloak or any OIDC issuer. Absent means the engine's own settings apply. With app.auth.* set the section is refused unless it says exactly the same; with app.security.auth.* it is always refused. Secrets are never written here.",
      "required": [
        "audience"
      ],
      "properties": {
        "jwksUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://|^http://(localhost|127\\.|\\[::1\\]|[^/]*\\.svc|[^/]*\\.cluster\\.local)",
          "description": "The provider's key set. https only (plain http to localhost, loopback, *.svc or *.cluster.local). Needs `issuer`."
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "description": "Checked against the token's `iss`. Alone (without jwksUrl or secret) it also finds the keys through OIDC discovery."
        },
        "secret": {
          "type": "string",
          "pattern": "^(env:[A-Za-z_][A-Za-z0-9_]*|file:\\S.*)$",
          "description": "HMAC shared secret as a reference, env:NAME or file:/path, never the secret itself. At least 32 bytes."
        },
        "algorithms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "RS256",
              "RS384",
              "RS512",
              "ES256",
              "ES384",
              "ES512",
              "PS256",
              "PS384",
              "PS512",
              "HS256",
              "HS384",
              "HS512"
            ]
          },
          "description": "The only algorithms accepted. Default RS256 and ES256 (HS256 with a secret). HS* only with `secret`, the others only with a key set."
        },
        "audience": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "description": "The token's `aud` must contain this (or one of these)."
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Path to the role: a string, or a list of the roles the caller may act as. Default `role`. Dotted, e.g. realm_access.roles or https://hasura.io/jwt/claims.x-hasura-default-role."
            },
            "defaultRole": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,62}$",
              "not": {
                "const": "service"
              },
              "description": "The active role when `role` is a list; the X-Excalibase-Role header may pick another one from the list."
            },
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Path to the caller's id. Default `sub`. It fills X-Excalibase-User-Id."
            },
            "extra": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "description": "Session-variable name to claim path; each becomes X-Excalibase-<name> in rules."
            }
          }
        },
        "clockSkew": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300,
          "default": 30,
          "description": "Seconds of clock difference tolerated on exp and nbf."
        }
      },
      "anyOf": [
        {
          "required": [
            "issuer"
          ]
        },
        {
          "required": [
            "secret"
          ]
        }
      ],
      "dependentRequired": {
        "jwksUrl": [
          "issuer"
        ]
      },
      "not": {
        "required": [
          "secret",
          "jwksUrl"
        ]
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tableRule"
      },
      "default": []
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trackedFunction"
      },
      "default": []
    },
    "functionPermissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/functionPermission"
      },
      "default": []
    }
  },
  "$defs": {
    "qualifiedName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_$]{0,62}\\.[a-z_][a-z0-9_$]{0,62}$"
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]{0,62}$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "service"
      }
    },
    "expression": {
      "type": "object",
      "description": "A boolean expression, e.g. {\"owner_id\": {\"_eq\": \"X-Excalibase-User-Id\"}}. {} means every row."
    },
    "columns": {
      "oneOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldName"
          },
          "uniqueItems": true
        }
      ]
    },
    "presets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/fieldName"
      }
    },
    "tableRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "role"
      ],
      "properties": {
        "table": {
          "$ref": "#/$defs/qualifiedName"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "select": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filter",
            "columns"
          ],
          "properties": {
            "filter": {
              "$ref": "#/$defs/expression"
            },
            "columns": {
              "$ref": "#/$defs/columns"
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "allowAggregations": {
              "type": "boolean"
            }
          }
        },
        "insert": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check",
            "columns"
          ],
          "properties": {
            "check": {
              "$ref": "#/$defs/expression"
            },
            "columns": {
              "$ref": "#/$defs/columns"
            },
            "set": {
              "$ref": "#/$defs/presets"
            }
          }
        },
        "update": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filter",
            "check",
            "columns"
          ],
          "properties": {
            "filter": {
              "$ref": "#/$defs/expression"
            },
            "check": {
              "$ref": "#/$defs/expression"
            },
            "columns": {
              "$ref": "#/$defs/columns"
            },
            "set": {
              "$ref": "#/$defs/presets"
            }
          }
        },
        "delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filter"
          ],
          "properties": {
            "filter": {
              "$ref": "#/$defs/expression"
            }
          }
        }
      }
    },
    "trackedFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "exposedAs",
        "inferPermissions"
      ],
      "properties": {
        "function": {
          "$ref": "#/$defs/qualifiedName"
        },
        "exposedAs": {
          "enum": [
            "QUERY",
            "MUTATION"
          ]
        },
        "inferPermissions": {
          "type": "boolean"
        },
        "sessionArgument": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "functionPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "role"
      ],
      "properties": {
        "function": {
          "$ref": "#/$defs/qualifiedName"
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      }
    }
  }
}
