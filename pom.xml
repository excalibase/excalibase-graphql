<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.micronaut.platform</groupId>
        <artifactId>micronaut-parent</artifactId>
        <version>4.10.24</version>
        <relativePath/>
    </parent>

    <groupId>io.github.excalibase</groupId>
    <artifactId>excalibase-graphql-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>excalibase-graphql-parent</name>
    <url/>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>excalibase</id>
            <name>Excalibase Team</name>
        </developer>
    </developers>
    <modules>
        <!-- RLS engine modules (vendored): pure library, no runtime deps.
             Listed first as graphql-api depends on them. -->
        <module>modules/excalibase-rls-core</module>
        <module>modules/excalibase-rls-jdbc</module>
        <module>modules/excalibase-graphql-api</module>
        <module>modules/excalibase-graphql-starter</module>
        <module>modules/excalibase-graphql-postgres</module>
        <module>modules/excalibase-graphql-mysql</module>
        <module>modules/excalibase-rest-api</module>
        <!-- rest-api before graphql-api: graphql-api depends on rest-api -->
    </modules>

    <scm>
        <connection>scm:git:https://github.com/excalibase/excalibase-graphql.git</connection>
        <developerConnection>scm:git:https://github.com/excalibase/excalibase-graphql.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/excalibase/excalibase-graphql</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <release.version>25</release.version>
        <micronaut.runtime>netty</micronaut.runtime>
        <!-- Spring Framework is used as plain libraries (JdbcTemplate, TransactionTemplate), on its current line -->
        <spring.framework.version>7.0.10</spring.framework.version>
        <micronaut.platform.version>4.10.24</micronaut.platform.version>
        <!-- Pinned to patch Snyk HIGH CVEs in jackson-core 2.19.4 -->
        <jackson.version>2.21.7</jackson.version>
        <!-- A test fork that hangs is killed after 40 minutes; the slowest module takes about 15 -->
        <surefire.timeout>2400</surefire.timeout>
        <native-maven-plugin.version>0.10.6</native-maven-plugin.version>
        <!-- databases -->
        <postgresql.version>42.7.12</postgresql.version>
        <opentelemetry.version>1.67.0</opentelemetry.version>
        <assertj.version>3.27.7</assertj.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <kotlin-stdlib.version>2.3.21</kotlin-stdlib.version>
        <mysql.connector.version>9.3.0</mysql.connector.version>
        <!--java graphql-->
        <graphql.java.version>24.0</graphql.java.version>

        <!--own module-->
        <excalibase.version>0.0.1-SNAPSHOT</excalibase.version>

        <!--groovy & spock-->
        <groovy-all.version>4.0.24</groovy-all.version>
        <spock-core.version>2.4-M4-groovy-4.0</spock-core.version>
        <groovy-json.version>4.0.24</groovy-json.version>

        <!--nats-->
        <jnats.version>2.22.0</jnats.version>
        <!-- jnats brings 2.73.8; pinned past CVE-2026-8763 (EXC-642) -->
        <bouncycastle.version>2.73.13</bouncycastle.version>

        <!--testing-->
        <testcontainers.version>1.21.4</testcontainers.version>
        <awaitility.version>4.3.0</awaitility.version>

        <!--observability-->
        <opentelemetry-instrumentation.version>2.16.0-alpha</opentelemetry-instrumentation.version>

        <!-- SonarCloud. Token via SONAR_TOKEN env / -Dsonar.token=<token> at CLI. -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>excalibase</sonar.organization>
        <sonar.projectKey>excalibase_excalibase-graphql</sonar.projectKey>
        <sonar.projectName>Excalibase Graphql</sonar.projectName>
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/modules/excalibase-graphql-api/target/site/jacoco-aggregate/jacoco.xml,${maven.multiModuleProjectDirectory}/modules/excalibase-graphql-api/target/site/jacoco/jacoco.xml,${maven.multiModuleProjectDirectory}/modules/excalibase-rls-core/target/site/jacoco/jacoco.xml,${maven.multiModuleProjectDirectory}/modules/excalibase-rls-jdbc/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>
            **/ExcalibaseGraphqlApplication.java,
            **/config/**,
            **/model/**
        </sonar.exclusions>
        <!-- The console's browser scripts are not measured by JaCoCo -->
        <sonar.coverage.exclusions>**/resources/console/**</sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Test-scope advisories: assertj XXE (fixed 3.27.7), commons-lang3 (fixed 3.18.0) -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <!-- Micronaut's platform BOM imports kotlin-bom 1.9.25, which downgrades the kotlin-stdlib OkHttp (the OTLP sender)
                 declares itself (2.1.21) to a 1.9.x with CVE-2020-29582, fixed in 2.1.0 -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin-stdlib.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>1.18.0</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-lts8on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- Patched Jackson line (several High advisories below 2.21.7); the BOM keeps core, databind, datatypes aligned -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Framework first: the Micronaut platform pins an older line of the same libraries -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring.framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.micronaut.platform</groupId>
                <artifactId>micronaut-platform</artifactId>
                <version>${micronaut.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-jdbc</artifactId>
                <version>${spring.framework.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-tx</artifactId>
                <version>${spring.framework.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-beans</artifactId>
                <version>${spring.framework.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-core</artifactId>
                <version>${spring.framework.version}</version>
                <exclusions>
                    <!-- Spring's own log lines go through SLF4J, like every other line (jcl-over-slf4j) -->
                    <exclusion>
                        <groupId>commons-logging</groupId>
                        <artifactId>commons-logging</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
            </dependency>

            <!--Own modules-->
            <dependency>
                <groupId>io.github.excalibase</groupId>
                <artifactId>excalibase-graphql-starter</artifactId>
                <version>${excalibase.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.excalibase</groupId>
                <artifactId>excalibase-graphql-postgres</artifactId>
                <version>${excalibase.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.excalibase</groupId>
                <artifactId>excalibase-graphql-mysql</artifactId>
                <version>${excalibase.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.excalibase</groupId>
                <artifactId>excalibase-rest-api</artifactId>
                <version>${excalibase.version}</version>
            </dependency>
            <!-- Row-level + column-level security engine (vendored reactor modules). -->
            <dependency>
                <groupId>io.github.excalibase</groupId>
                <artifactId>excalibase-rls-core</artifactId>
                <version>${excalibase.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.excalibase</groupId>
                <artifactId>excalibase-rls-jdbc</artifactId>
                <version>${excalibase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.connector.version}</version>
            </dependency>

            <!--Graphql-->
            <dependency>
                <groupId>com.graphql-java</groupId>
                <artifactId>graphql-java</artifactId>
                <version>${graphql.java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.graphql-java</groupId>
                <artifactId>graphql-java-extended-scalars</artifactId>
                <version>22.0</version>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!--NATS-->
            <dependency>
                <groupId>io.nats</groupId>
                <artifactId>jnats</artifactId>
                <version>${jnats.version}</version>
            </dependency>

            <!--Observability-->
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-instrumentation.version}</version>
            </dependency>

            <!--Testing-->
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy-all</artifactId>
                <version>${groovy-all.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>org.spockframework</groupId>
                <artifactId>spock-core</artifactId>
                <version>${spock-core.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.spockframework</groupId>
                <artifactId>spock-spring</artifactId>
                <version>${spock-core.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.groovy</groupId>
                <artifactId>groovy-json</artifactId>
                <version>${groovy-json.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>vault</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>spock</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>native</id>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.graalvm.buildtools</groupId>
                            <artifactId>native-maven-plugin</artifactId>
                            <version>${native-maven-plugin.version}</version>
                        </plugin>
                    </plugins>
                </pluginManagement>
                <plugins>
                    <!-- micronaut-parent binds native test generation to every module; with -am it fails on the pom
                         parent and on jar modules. Only the api module builds an image. -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>test-native</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <excludes>
                        <!-- application main class -->
                        <exclude>**/ExcalibaseGraphqlApplication*</exclude>
                        <!-- framework configuration (includes ExcalibaseRuntimeHints) -->
                        <exclude>**/config/**</exclude>
                        <!-- Data models / POJOs -->
                        <exclude>**/model/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>4.0.1</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
