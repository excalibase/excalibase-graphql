{
  "name": "excalibase-console-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The engine's admin console, built with Vite. Served by the engine under /console when EXCALIBASE_CONSOLE_UI=next.",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.40.0",
    "@tanstack/react-query": "5.90.21",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "lucide-react": "0.564.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.4.20",
    "jsdom": "29.1.1",
    "oxlint": "1.68.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
