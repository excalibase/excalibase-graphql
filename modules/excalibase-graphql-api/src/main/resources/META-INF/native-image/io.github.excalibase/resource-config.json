{
  "resources": {
    "includes": [
      {
        "pattern": "application\\.yml"
      },
      {
        "pattern": "application-.*\\.yml"
      },
      {
        "pattern": "logback\\.xml"
      },
      {
        "pattern": ".*\\.sql"
      },
      {
        "pattern": "graphql/.*\\.graphqls"
      },
      {
        "pattern": "graphql/.*\\.graphql"
      },
      {
        "pattern": "META-INF/services/.*"
      },
      {
        "pattern": "META-INF/micronaut/.*"
      },
      {
        "pattern": "META-INF/native-image/.*"
      },
      {
        "pattern": "org/springframework/jdbc/support/sql-error-codes\\.xml"
      },
      {
        "pattern": "sql-error-codes\\.xml"
      },
      {
        "pattern": "org/postgresql/.*\\.properties"
      },
      {
        "pattern": "com/zaxxer/hikari/.*"
      }
    ]
  }
}